# ====================================================================
# HIMO MOJOKERTO RAYA - ENVIRONMENT CONFIGURATION
# Copy this file to .env and adjust credentials for your environment
# ====================================================================

# Environment Mode: development / production
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost

# Database Credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=himo_database
DB_USERNAME=root
DB_PASSWORD=

# Security & Sessions
SESSION_LIFETIME=7200
CSRF_SECRET=change_this_to_a_random_32_character_string_in_production
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_DECAY_MINUTES=15
